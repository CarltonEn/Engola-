OPENAI_API_KEY=replace-with-your-server-side-key
ENGOLA_MODEL=gpt-5.6
ENGOLA_OWNER_NAME=Engola Innocent
ENGOLA_SETUP_TOKEN=replace-with-a-long-random-one-time-token
WEBAUTHN_RP_NAME=Engola
WEBAUTHN_RP_ID=your-domain.example
WEBAUTHN_ORIGIN=https://your-domain.example
COOKIE_SECURE=1
SESSION_TTL_SECONDS=43200
SESSION_IDLE_SECONDS=1800

# Optional: Google OAuth (leave blank to keep /api/google/* honestly disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/google/callback
GOOGLE_SCOPES=openid email profile https://www.googleapis.com/auth/calendar.readonly

# Optional: voice narration TTS synthesis (leave blank -> script only, no audio)
TTS_PROVIDER_API_KEY=
